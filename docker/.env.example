# Copy to .env next to compose.yml. Never commit .env.
# Required: a long-lived token for your Claude subscription (`claude setup-token`).
CLAUDE_CODE_OAUTH_TOKEN=

# Everything below is optional; the defaults are shown.
# TZ=UTC                            (e.g. America/New_York, so the agent knows your date)
# JARVIS_NAME=Jarvis
# JARVIS_GREETING=Hello, what are we working on today?
# JARVIS_MODEL=                      (empty = backtalk's default)
# PERMISSION_MODE=ask                (or bypassPermissions: acts without asking)
# FACE=bioradial                     (or board, radial, rain, neural)
# How the BROWSER reaches the voice bridge. Same machine: the default works.
# Behind an HTTPS reverse proxy that forwards /ws to port 8792: wss://your.host/ws
# BACKEND_WS=ws://localhost:8792
# PIPER_VOICE=en_GB-semaine-medium   (any voice name from rhasspy/piper-voices)
# PIPER_SPEAKER=2                    (multi-speaker voices only)
# PIPER_LENGTH_SCALE=0.88            (below 1.0 talks faster)
# STT_MODEL=base.en
# AGENT_DIR=/home/jarvis/projects/Jarvis
# EXTRA_DIRS=                        (more folders the agent may use, separated by :)
# Full control instead: mount a folder at /config holding backtalk.json and/or
# ai-visualizer.json (see config/*.example.json); those replace the generated ones.
