# Copy to .env, fill in, chmod 600. Never commit .env.
CLAUDE_CODE_OAUTH_TOKEN=
# The container's own address on your macvlan network, and its DNS server.
JARVIS_IP=192.0.2.10
JARVIS_DNS=192.0.2.1
# Optional: the existing external Docker network to join (default network_macvlan0).
# JARVIS_NETWORK=
# Optional: in-container user. Match the owner of ./data on the host.
# JARVIS_USER=jarvis
# JARVIS_UID=1000
